<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SwimGoalTracker" parent="Theme.AppCompat">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:statusBarColor">@color/my_custom_status_bar_color</item>
        <item name="colorPrimary">@color/my_custom_app_bar_color</item>
        <item name="colorPrimaryVariant">#0B3C5D</item>
        <item name="colorOnPrimary">@color/white</item>
    </style>

    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/lightPrimary</item>
        <item name="colorPrimaryVariant">#0077B6</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/lightSecondary</item>
        <item name="colorAccent">@color/lightAccent</item>
        <item name="android:windowBackground">@color/lightBackground</item>
        <item name="colorOnSurface">@color/lightText</item>
        <item name="android:statusBarColor">@color/lightPrimaryDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/lightPrimaryDark</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:textColorPrimary">@color/lightText</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:buttonStyle">@style/WatercolorButton</item>
    </style>

    <style name="AppTheme_NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/lightPrimary</item>
        <item name="colorPrimaryVariant">#0077B6</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:statusBarColor">@color/midnight_blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorSecondary">@color/lightSecondary</item>
        <item name="colorAccent">@color/lightAccent</item>
        <item name="android:windowBackground">@color/lightBackground</item>
        <item name="colorSurface">@color/lightSurface</item>
        <item name="colorOnSurface">@color/lightText</item>
        <item name="android:statusBarColor">@color/lightPrimaryDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:textColorPrimary">@color/lightText</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:buttonStyle">@style/WatercolorButton</item>
    </style>

    <!-- Custom button style -->
    <style name="WatercolorButton" parent="Widget.AppCompat.Button">
        <item name="android:backgroundTint">#BFDCE5</item> <!-- Misty blue -->
        <item name="android:textColor">#FFFFFF</item>
    </style>
    <style name="CustomDatePickerDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="colorPrimary">@color/lightPrimary</item>
        <item name="colorAccent">@color/lightPrimary</item>
        <item name="android:textColorPrimary">@color/textPrimary</item>
        <item name="android:textColorHighlight">@color/lightPrimary</item>
        <item name="buttonBarPositiveButtonStyle">@style/CustomTextButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/CustomTextButton</item>
    </style>

    <style name="CustomTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/lightPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AlertDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:textColorPrimary">?android:attr/textColorPrimary</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <style name="Theme.SwimApp.Light" parent="Theme.MaterialComponents.Light">
        <item name="colorPrimary">@color/lightPrimary</item>
        <item name="colorSecondary">@color/lightSecondary</item>
        <item name="colorAccent">@color/lightAccent</item>
        <item name="android:statusBarColor">@color/midnight_blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">@color/lightBackground</item>
        <item name="android:textColor">@color/lightText</item>
    </style>

    <style name="Theme.SwimApp.Dark" parent="Theme.MaterialComponents">
        <item name="colorPrimary">@color/darkPrimary</item>
        <item name="colorAccent">@color/darkAccent</item>
        <item name="android:statusBarColor">@color/darkPrimaryDark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:colorBackground">@color/darkBackground</item>
        <item name="android:textColor">@color/darkText</item>
    </style>


</resources>