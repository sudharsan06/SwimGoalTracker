<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/bg_goal_achieved"
    android:maxWidth="340dp"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Trophy -->
        <TextView
            android:id="@+id/tvTrophy"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:gravity="center"
            android:text="🏆"
            android:textSize="36sp"
            android:background="@drawable/circle_bg_teal"
            android:shadowColor="#15D4FF"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="16" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvGoalTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="GOAL ACHIEVED!"
            android:textColor="@color/login_cyan"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/tvGoalSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="You beat your target! 💪"
            android:textColor="@color/login_text"
            android:textSize="14sp"
            android:alpha="0.9" />

        <!-- Swimmer Name -->
        <TextView
            android:id="@+id/tvSwimmerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="@color/login_text"
            android:textSize="13sp"
            android:alpha="0.8" />

        <!-- Stats Row -->
        <LinearLayout
            android:id="@+id/layoutStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STYLE"
                    android:textColor="@color/login_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Freestyle"
                    android:textColor="@color/login_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISTANCE"
                    android:textColor="@color/login_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="50 m"
                    android:textColor="@color/login_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TIME"
                    android:textColor="@color/login_cyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStatTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="00:31.82"
                    android:textColor="@color/login_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <!-- Attempts Message -->
        <TextView
            android:id="@+id/tvAttemptLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="You achieved this goal after"
            android:textColor="@color/login_text"
            android:textSize="13sp"
            android:alpha="0.9" />

        <TextView
            android:id="@+id/tvAttemptCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 Attempts"
            android:textColor="@color/sun_gold"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMotivation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Consistency beats talent.\nKeep swimming and keep improving! 🌊"
            android:textColor="@color/login_text"
            android:textSize="13sp"
            android:alpha="0.9" />

        <!-- Expandable Pace Calculator -->
        <LinearLayout
            android:id="@+id/layoutPaceToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="View Pace Details"
                android:textColor="@color/login_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPaceChevron"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼"
                android:textColor="@color/login_cyan"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Pace Details Content -->
        <LinearLayout
            android:id="@+id/layoutPaceContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvPaceInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/login_text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="2"
                android:background="@drawable/btn_share_border"
                android:foreground="?attr/selectableItemBackground"
                android:stateListAnimator="@null"
                android:text="📤 Share"
                android:textAllCaps="false"
                android:textColor="@color/login_cyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnDone"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/login_btn_gradient"
                android:foreground="?attr/selectableItemBackground"
                android:stateListAnimator="@null"
                android:text="Done"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
