<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/recordCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="@color/dark_surface_lowest"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/dark_outline_variant"
    app:strokeWidth="1dp">

    <HorizontalScrollView
        android:id="@+id/rowScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="14dp"
            android:paddingStart="4dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="8dp">

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jun 19"
                    android:textColor="@color/dark_on_surface"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif" />

                <TextView
                    android:id="@+id/tv_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FRIDAY"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:visibility="gone" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/lay_free_container"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="00:00.00"
                        android:textColor="@color/dark_on_surface"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/badge_free"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PB"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_secondary"
                        android:letterSpacing="0.08"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/lay_fly_container"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_fly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="00:00.00"
                        android:textColor="@color/dark_on_surface"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/badge_fly"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PB"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_secondary"
                        android:letterSpacing="0.08"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/lay_breast_container"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_breast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="00:00.00"
                        android:textColor="@color/dark_on_surface"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/badge_breast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PB"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_secondary"
                        android:letterSpacing="0.08"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/lay_back_container"
                android:layout_width="76dp"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="00:00.00"
                        android:textColor="@color/dark_on_surface"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif" />

                    <TextView
                        android:id="@+id/badge_back"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PB"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:textColor="@color/dark_secondary"
                        android:letterSpacing="0.08"
                        android:visibility="gone" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

    </HorizontalScrollView>

</com.google.android.material.card.MaterialCardView>
