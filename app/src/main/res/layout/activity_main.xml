<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/top_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/dark_surface_low"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            android:foreground="@drawable/bottom_border_white_10">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingVertical="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLogo"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="@color/dark_surface_high"
                    app:strokeWidth="0dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <ImageView
                        android:id="@+id/ivLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/sgt_logo_alone" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="SwimminGO"
                    android:textColor="@color/dark_primary_fixed_dim"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/cardLogo"
                    app:layout_constraintEnd_toStartOf="@id/btnOpenProfile"
                    app:layout_constraintStart_toEndOf="@id/cardLogo"
                    app:layout_constraintTop_toTopOf="@id/cardLogo" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnOpenProfile"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardBackgroundColor="@color/dark_surface_high"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:layout_constraintBottom_toBottomOf="@id/cardLogo"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/cardLogo"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/ivProfileIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="@color/dark_on_surface" />
                </com.google.android.material.card.MaterialCardView>

                <ImageView
                    android:id="@+id/ivSwitchProfileBadge"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:background="@drawable/circle_bg_teal"
                    android:padding="2dp"
                    android:src="@android:drawable/ic_popup_sync"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="@id/btnOpenProfile"
                    app:layout_constraintEnd_toEndOf="@id/btnOpenProfile"
                    app:tint="@color/dark_background" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="80dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Greeting Section -->
                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good Morning, Swimmer!"
                    android:textColor="@color/dark_primary"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:alpha="0.7"
                    android:text="Today: 2026-06-19"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:letterSpacing="0.1" />

                <!-- Stats Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- Weekly Performance Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="3"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_card_featured"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/tvWeeklyHeader"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WEEKLY PERFORMANCE"
                                android:textColor="@color/dark_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.08" />

                            <LinearLayout
                                android:id="@+id/layWeeklyMetric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/tvWeeklyHeader"
                                android:layout_marginTop="16dp"
                                android:orientation="horizontal"
                                android:gravity="bottom">

                                <TextView
                                    android:id="@+id/tvWeeklyDistance"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0.0"
                                    android:textColor="@color/dark_primary_fixed_dim"
                                    android:textSize="36sp"
                                    android:textStyle="bold"
                                    android:fontFamily="sans-serif-black" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_marginBottom="6dp"
                                    android:text="km"
                                    android:textColor="@color/dark_on_surface_variant"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Progress Bar -->
                            <FrameLayout
                                android:id="@+id/layProgressTrack"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_below="@id/layWeeklyMetric"
                                android:layout_marginTop="20dp"
                                android:background="@drawable/bg_progress_track">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:weightSum="100">

                                    <View
                                        android:id="@+id/viewProgressFill"
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="0"
                                        android:background="@drawable/bg_progress_fill" />
                                </LinearLayout>
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/layProgressTrack"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvWeeklyGoal"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Goal: 18.0 km"
                                    android:textColor="@color/dark_on_surface_variant"
                                    android:textSize="11sp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:background="?attr/selectableItemBackground" />

                                <TextView
                                    android:id="@+id/tvWeeklyPercent"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0% complete"
                                    android:textColor="@color/dark_on_surface_variant"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Start New Session Card -->
                   <!-- <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_glass_card"
                            android:gravity="center"
                            android:orientation="vertical"
