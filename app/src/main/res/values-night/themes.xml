<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/darkPrimary</item>
        <item name="colorPrimaryVariant">#03045E</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/darkSecondary</item>
        <item name="colorAccent">@color/darkAccent</item>
        <item name="android:windowBackground">@color/darkBackground</item>
        <item name="colorSurface">@color/darkSurface</item>
        <item name="android:statusBarColor">@color/midnight_blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="colorOnSurface">@color/darkText</item>
        <item name="android:textColorPrimary">@color/darkText</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:buttonStyle">@style/WatercolorButton</item>
    </style>

    <style name="AppTheme_NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/darkPrimary</item>
        <item name="colorPrimaryVariant">#03045E</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/darkSecondary</item>
        <item name="colorAccent">@color/darkAccent</item>
        <item name="android:statusBarColor">@color/midnight_blue</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/darkBackground</item>
        <item name="colorSurface">@color/darkSurface</item>
        <item name="colorOnSurface">@color/darkText</item>
        <item name="android:textColorPrimary">@color/darkText</item>
        <item name="android:textColorSecondary">@color/textSecondary</item>
        <item name="android:buttonStyle">@style/WatercolorButton</item>
    </style>
</resources>