<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Current Workout Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@color/dark_surface_low"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:background="@drawable/bg_glass_card"
                android:layout_marginEnd="12dp">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:scaleType="centerCrop"
                    android:gravity="center"
                    android:background="@color/dark_primary_fixed_dim"
                    android:src="@drawable/sgt_logo_alone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CURRENT WORKOUT"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="10sp"
                    android:letterSpacing="0.05"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Individual Medley"
                    android:textColor="@color/dark_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@color/dark_surface_high"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    app:tint="@color/dark_primary_fixed_dim"
                    android:src="@drawable/ic_open_water" />

                <TextView
                    android:id="@+id/tvIMPoolDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="25m"
                    android:textColor="@color/dark_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Split Times -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="8dp">

            <RelativeLayout
                android:id="@+id/layImFly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvLabelImFly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. Butterfly (Fly)"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvImFlyVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="00:00.00"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/layImBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvLabelImBack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Backstroke (Back)"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvImBackVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="00:00.00"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/layImBreast"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvLabelImBreast"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. Breaststroke (Breast)"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvImBreastVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="00:00.00"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/layImFree"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="6dp"
                android:paddingHorizontal="8dp">

                <TextView
                    android:id="@+id/tvLabelImFree"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. Freestyle (Free)"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvImFreeVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="00:00.00"
                    android:textColor="@color/dark_on_surface_variant"
                    android:textSize="13sp" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Timer Area -->
        <TextView
            android:id="@+id/tvIMReadyBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="READY TO SWIM"
            android:textColor="@color/dark_on_surface_variant"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:background="@color/dark_surface_high"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvIM"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginVertical="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="00:00.00"
            android:textColor="@color/dark_primary"
            android:textSize="56sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Press start when you leave the wall"
            android:textColor="@color/dark_on_surface_variant"
            android:textSize="14sp" />

        <!-- Target & Previous Cards -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@color/dark_surface"
                android:padding="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        app:tint="@color/dark_primary_fixed_dim"
                        android:src="@drawable/ic_nav_goals" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="TARGET"
                        android:textColor="@color/dark_on_surface_variant"
                        android:textSize="10sp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvIMTarget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--:--.--"
                    android:textColor="@color/dark_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@color/dark_surface"
                android:padding="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        app:tint="@color/dark_primary_fixed_dim"
                        android:src="@drawable/ic_clock_previous_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="PREVIOUS"
                        android:textColor="@color/dark_on_surface_variant"
                        android:textSize="10sp"
                        android:letterSpacing="0.05"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvIMPrevious"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="--:--.--"
                    android:textColor="@color/dark_on_surface"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Play Button Area -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnIMReset"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_marginEnd="24dp"
                android:layout_toStartOf="@+id/btnIMPlayPause"
                android:background="@drawable/bg_glass_card"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_revert"
                android:visibility="gone"
                android:contentDescription="Reset" />

            <ImageButton
                android:id="@+id/btnIMPlayPause"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_centerInParent="true"
                android:background="@drawable/circle_bg_teal"
                android:padding="24dp"
                android:src="@android:drawable/ic_media_play"
                android:contentDescription="Play/Pause"
                android:elevation="4dp" />

            <ImageButton
                android:id="@+id/btn_save_im"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="24dp"
                android:layout_toEndOf="@+id/btnIMPlayPause"
                android:background="@drawable/bg_glass_card"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_save"
                android:visibility="gone"
                android:contentDescription="Save" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvIMPlayLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="START IM"
            android:textColor="@color/dark_primary"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:textStyle="bold" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
